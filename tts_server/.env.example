# 실제 키는 .env 또는 Render Environment에만 입력하세요.
# 이 파일에는 진짜 키를 적거나 커밋하지 마세요.
OPENAI_API_KEY=sk-your-openai-api-key

# 쉼표로 구분한 프론트엔드 주소만 TTS 요청을 허용합니다.
ALLOWED_ORIGINS=https://simhanna.github.io,https://myeonjeopkok.onrender.com,http://localhost:8000,http://127.0.0.1:8000

# Render에서는 PORT를 자동으로 제공합니다.
PORT=10000

